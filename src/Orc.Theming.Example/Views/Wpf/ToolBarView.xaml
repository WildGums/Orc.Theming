<catel:UserControl x:Class="Orc.Theming.Example.Views.ToolBarView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:catel="http://schemas.catelproject.com"
                   xmlns:ribbon="clr-namespace:Orc.Theming.Example"
                   xmlns:orctheming="http://schemas.wildgums.com/orc/theming">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button Command="New" Content="{catel:LanguageBinding ToolBarView_New}" />
                    <Button Command="Open" Content="{catel:LanguageBinding ToolBarView_Open}" />
                    <Button Command="Save" Content="{catel:LanguageBinding ToolBarView_Save}" />
                </ToolBar>
                <ToolBar>
                    <Button Command="Cut" Content="{catel:LanguageBinding ToolBarView_Cut}" />
                    <Button Command="Copy" Content="{catel:LanguageBinding ToolBarView_Copy}" />
                    <Button Command="Paste" Content="{catel:LanguageBinding ToolBarView_Paste}" />
                </ToolBar>
            </ToolBarTray>
            <TextBox AcceptsReturn="True" />
        </DockPanel>
    </StackPanel>
    
</catel:UserControl>
