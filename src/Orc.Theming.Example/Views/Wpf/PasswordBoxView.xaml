<catel:UserControl x:Class="Orc.Theming.Example.Views.PasswordBoxView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:catel="http://schemas.catelproject.com">

    <Grid FocusManager.FocusedElement="{Binding ElementName=FocusTextBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Default State" FontWeight="Bold" />
        <PasswordBox Grid.Row="1" />

        <TextBlock Grid.Row="2" Text="Default Focused" FontWeight="Bold" Margin="0,10,0,0" />
        <PasswordBox x:Name="FocusTextBox"
                     Grid.Row="3" />
    </Grid>

</catel:UserControl>
