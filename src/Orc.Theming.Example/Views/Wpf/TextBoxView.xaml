<catel:UserControl x:Class="Orc.Theming.Example.Views.TextBoxView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:catel="http://schemas.catelproject.com">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Default State" FontWeight="Bold" />
        <TextBox Grid.Row="1" />

        <TextBlock Grid.Row="2" Text="TextBox with validation error (empty text)" FontWeight="Bold" Margin="0,10,0,0" />
        <TextBox Grid.Row="3"
                 Text="{Binding ValidationTestText, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />

        <TextBlock Grid.Row="4" Text="Multiline with Text Wrapping" FontWeight="Bold" Margin="0,10,0,0" />
        <TextBox Grid.Row="5"
                 Text="{catel:LanguageBinding TextBoxView_HorizontalStretch}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="80"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Stretch"/>
    </Grid>

</catel:UserControl>
