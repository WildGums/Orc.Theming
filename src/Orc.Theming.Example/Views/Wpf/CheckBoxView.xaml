<catel:UserControl x:Class="Orc.Theming.Example.Views.CheckBoxView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:catel="http://schemas.catelproject.com">

    <StackPanel Orientation="Vertical">
        <CheckBox Content="{catel:LanguageBinding CheckBoxView_UncheckedState}" IsChecked="False" />
        <CheckBox Content="{catel:LanguageBinding CheckBoxView_UncheckedDisabledState}" IsEnabled="False" IsChecked="False" />
        <CheckBox Content="{catel:LanguageBinding CheckBoxView_ThreeState}" IsChecked="{x:Null}" IsThreeState="True"/>
        <CheckBox Content="{catel:LanguageBinding CheckBoxView_CheckedState}" IsChecked="True" />
        <CheckBox Content="{catel:LanguageBinding CheckBoxView_CheckedDisabledState}" IsEnabled="False" IsChecked="True" />
    </StackPanel>

</catel:UserControl>
